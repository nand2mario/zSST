  "series": [
    {"name": "fogTable{index:02d}", "base": 352, "stride": 4, "count": 32, "group": "fog table", "description": "Fog table word {index}", "defaults": {"access": "wo", "chips": "FBI", "fifo": true, "sync": true, "reset": null, "side_effect": "table", "fields": []}},
