        {"name": "fdTdX", "address": 216, "description": "T/W X gradient, IEEE-754 alias"},
        {"name": "fdWdX", "address": 220, "description": "1/W X gradient, IEEE-754 alias"},
        {"name": "fdRdY", "address": 224, "description": "Red Y gradient, IEEE-754 alias"},
        {"name": "fdGdY", "address": 228, "description": "Green Y gradient, IEEE-754 alias"},
        {"name": "fdBdY", "address": 232, "description": "Blue Y gradient, IEEE-754 alias"},
        {"name": "fdZdY", "address": 236, "description": "Z Y gradient, IEEE-754 alias"},
        {"name": "fdAdY", "address": 240, "description": "Alpha Y gradient, IEEE-754 alias"},
        {"name": "fdSdY", "address": 244, "description": "S/W Y gradient, IEEE-754 alias"},
        {"name": "fdTdY", "address": 248, "description": "T/W Y gradient, IEEE-754 alias"},
        {"name": "fdWdY", "address": 252, "description": "1/W Y gradient, IEEE-754 alias"},
