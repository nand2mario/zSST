    {
      "name": "FBI state and commands",
      "defaults": {"access": "rw", "chips": "FBI", "fifo": true, "sync": true, "reset": null, "side_effect": "state", "fields": []},
      "registers": [
        {"name": "status", "address": 0, "access": "rw", "fifo": true, "sync": false, "side_effect": "status_clear", "description": "Read FIFO/busy/retrace/swap status; write clears SST-1 PCI interrupts", "fields": [{"name": "pci_fifo_free", "lsb": 0, "msb": 5}, {"name": "v_retrace", "lsb": 6, "msb": 6}, {"name": "fbi_busy", "lsb": 7, "msb": 7}, {"name": "tmu_busy", "lsb": 8, "msb": 8}, {"name": "sst_busy", "lsb": 9, "msb": 9}, {"name": "displayed_buffer", "lsb": 10, "msb": 11}, {"name": "mem_fifo_free", "lsb": 12, "msb": 27}, {"name": "swaps_pending", "lsb": 28, "msb": 30}, {"name": "pci_interrupt", "lsb": 31, "msb": 31}]},
        {"name": "fbzColorPath", "address": 260, "chips": "FBI+TREX", "sync": false, "description": "Color/alpha combine and texture enable", "fields": [{"name": "rgb_select", "lsb": 0, "msb": 1}, {"name": "alpha_select", "lsb": 2, "msb": 3}, {"name": "local_select", "lsb": 4, "msb": 4}, {"name": "alpha_local_select", "lsb": 5, "msb": 6}, {"name": "cc", "lsb": 8, "msb": 16}, {"name": "cca", "lsb": 17, "msb": 25}, {"name": "parameter_adjust", "lsb": 26, "msb": 26}, {"name": "texture_enable", "lsb": 27, "msb": 27}]},
        {"name": "fogMode", "address": 264, "sync": false, "description": "Fog mode", "fields": [{"name": "enable", "lsb": 0, "msb": 0}, {"name": "add", "lsb": 1, "msb": 1}, {"name": "multiply", "lsb": 2, "msb": 2}, {"name": "source", "lsb": 3, "msb": 5}]},
        {"name": "alphaMode", "address": 268, "sync": false, "description": "Alpha test and blend control", "fields": [{"name": "test_enable", "lsb": 0, "msb": 0}, {"name": "test_function", "lsb": 1, "msb": 3}, {"name": "blend_enable", "lsb": 4, "msb": 4}, {"name": "antialias_enable", "lsb": 5, "msb": 5}, {"name": "rgb_source_factor", "lsb": 8, "msb": 11}, {"name": "rgb_dest_factor", "lsb": 12, "msb": 15}, {"name": "alpha_source_factor", "lsb": 16, "msb": 19}, {"name": "alpha_dest_factor", "lsb": 20, "msb": 23}, {"name": "alpha_reference", "lsb": 24, "msb": 31}]},
        {"name": "fbzMode", "address": 272, "description": "Framebuffer, clipping, depth and write control", "fields": [{"name": "clip_enable", "lsb": 0, "msb": 0}, {"name": "chroma_enable", "lsb": 1, "msb": 1}, {"name": "stipple_enable", "lsb": 2, "msb": 2}, {"name": "w_buffer", "lsb": 3, "msb": 3}, {"name": "depth_enable", "lsb": 4, "msb": 4}, {"name": "depth_function", "lsb": 5, "msb": 7}, {"name": "dither_enable", "lsb": 8, "msb": 8}, {"name": "rgb_write", "lsb": 9, "msb": 9}, {"name": "aux_write", "lsb": 10, "msb": 10}, {"name": "dither_2x2", "lsb": 11, "msb": 11}, {"name": "stipple_pattern", "lsb": 12, "msb": 12}, {"name": "alpha_mask", "lsb": 13, "msb": 13}, {"name": "draw_buffer", "lsb": 14, "msb": 15}, {"name": "depth_bias", "lsb": 16, "msb": 16}, {"name": "y_origin", "lsb": 17, "msb": 17}, {"name": "alpha_buffer", "lsb": 18, "msb": 18}, {"name": "dither_subtract", "lsb": 19, "msb": 19}, {"name": "depth_source", "lsb": 20, "msb": 20}]},
        {"name": "lfbMode", "address": 276, "description": "Linear framebuffer format, buffer and pipeline control", "fields": [{"name": "write_format", "lsb": 0, "msb": 3}, {"name": "write_buffer", "lsb": 4, "msb": 5}, {"name": "read_buffer", "lsb": 6, "msb": 7}, {"name": "pixel_pipeline", "lsb": 8, "msb": 8}, {"name": "rgba_lanes", "lsb": 9, "msb": 10}, {"name": "word_swap_writes", "lsb": 11, "msb": 11}, {"name": "byte_swizzle_writes", "lsb": 12, "msb": 12}, {"name": "y_origin", "lsb": 13, "msb": 13}, {"name": "pipeline_w_select", "lsb": 14, "msb": 14}, {"name": "word_swap_reads", "lsb": 15, "msb": 15}, {"name": "byte_swizzle_reads", "lsb": 16, "msb": 16}]},
        {"name": "clipLeftRight", "address": 280, "description": "Inclusive left and exclusive right clip coordinates"},
        {"name": "clipLowYHighY", "address": 284, "description": "Inclusive low-Y and exclusive high-Y clip coordinates"},
        {"name": "nopCMD", "address": 288, "access": "wo", "chips": "FBI+TREX", "side_effect": "command", "description": "Execute NOP/fence and optional counter reset"},
        {"name": "fastfillCMD", "address": 292, "access": "wo", "side_effect": "command", "description": "Execute fast rectangle fill"},
        {"name": "swapbufferCMD", "address": 296, "access": "wo", "side_effect": "command", "description": "Queue a display-buffer swap"},
        {"name": "fogColor", "address": 300, "description": "Constant RGB888 fog color"},
        {"name": "zaColor", "address": 304, "description": "Constant alpha and depth value"},
        {"name": "chromaKey", "address": 308, "description": "RGB888 chroma-key value"},
        {"name": "stipple", "address": 320, "description": "Rotating or pattern stipple value"},
        {"name": "color0", "address": 324, "description": "ARGB8888 constant color zero"},
        {"name": "color1", "address": 328, "description": "ARGB8888 constant color one / fast-fill color"},
        {"name": "fbiPixelsIn", "address": 332, "access": "ro", "side_effect": "counter", "description": "Pixels entering FBI"},
        {"name": "fbiChromaFail", "address": 336, "access": "ro", "side_effect": "counter", "description": "Pixels rejected by chroma test"},
        {"name": "fbiZfuncFail", "address": 340, "access": "ro", "side_effect": "counter", "description": "Pixels rejected by depth test"},
        {"name": "fbiAfuncFail", "address": 344, "access": "ro", "side_effect": "counter", "description": "Pixels rejected by alpha test"},
        {"name": "fbiPixelsOut", "address": 348, "access": "ro", "side_effect": "counter", "description": "Pixels written by FBI"}
      ]
