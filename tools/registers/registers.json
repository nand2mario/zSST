  "groups": [
    {
      "name": "fixed triangle parameters",
      "defaults": {"access": "wo", "chips": "FBI+TREX", "fifo": true, "sync": false, "reset": null, "side_effect": "state", "fields": []},
      "registers": [
        {"name": "vertexAx", "address": 8, "description": "Vertex A X, signed 12.4"},
        {"name": "vertexAy", "address": 12, "description": "Vertex A Y, signed 12.4"},
        {"name": "vertexBx", "address": 16, "description": "Vertex B X, signed 12.4"},
        {"name": "vertexBy", "address": 20, "description": "Vertex B Y, signed 12.4"},
        {"name": "vertexCx", "address": 24, "description": "Vertex C X, signed 12.4"},
        {"name": "vertexCy", "address": 28, "description": "Vertex C Y, signed 12.4"},
        {"name": "startR", "address": 32, "description": "Starting red, signed 12.12"},
        {"name": "startG", "address": 36, "description": "Starting green, signed 12.12"},
        {"name": "startB", "address": 40, "description": "Starting blue, signed 12.12"},
        {"name": "startZ", "address": 44, "description": "Starting Z, signed 20.12"},
        {"name": "startA", "address": 48, "description": "Starting alpha, signed 12.12"},
        {"name": "startS", "address": 52, "description": "Starting S/W, signed 14.18"},
        {"name": "startT", "address": 56, "description": "Starting T/W, signed 14.18"},
        {"name": "startW", "address": 60, "description": "Starting 1/W, signed 2.30"},
        {"name": "dRdX", "address": 64, "description": "Red X gradient, signed 12.12"},
        {"name": "dGdX", "address": 68, "description": "Green X gradient, signed 12.12"},
        {"name": "dBdX", "address": 72, "description": "Blue X gradient, signed 12.12"},
        {"name": "dZdX", "address": 76, "description": "Z X gradient, signed 20.12"},
        {"name": "dAdX", "address": 80, "description": "Alpha X gradient, signed 12.12"},
        {"name": "dSdX", "address": 84, "description": "S/W X gradient, signed 14.18"},
        {"name": "dTdX", "address": 88, "description": "T/W X gradient, signed 14.18"},
        {"name": "dWdX", "address": 92, "description": "1/W X gradient, signed 2.30"},
        {"name": "dRdY", "address": 96, "description": "Red Y gradient, signed 12.12"},
        {"name": "dGdY", "address": 100, "description": "Green Y gradient, signed 12.12"},
        {"name": "dBdY", "address": 104, "description": "Blue Y gradient, signed 12.12"},
        {"name": "dZdY", "address": 108, "description": "Z Y gradient, signed 20.12"},
        {"name": "dAdY", "address": 112, "description": "Alpha Y gradient, signed 12.12"},
        {"name": "dSdY", "address": 116, "description": "S/W Y gradient, signed 14.18"},
        {"name": "dTdY", "address": 120, "description": "T/W Y gradient, signed 14.18"},
        {"name": "dWdY", "address": 124, "description": "1/W Y gradient, signed 2.30"},
        {"name": "triangleCMD", "address": 128, "description": "Execute fixed-point triangle", "side_effect": "command"}
      ]
    },
    {
      "name": "floating triangle parameters",
      "defaults": {"access": "wo", "chips": "FBI+TREX", "fifo": true, "sync": false, "reset": null, "side_effect": "float_state", "fields": []},
      "registers": [
        {"name": "fvertexAx", "address": 136, "description": "Vertex A X, IEEE-754 alias"},
        {"name": "fvertexAy", "address": 140, "description": "Vertex A Y, IEEE-754 alias"},
        {"name": "fvertexBx", "address": 144, "description": "Vertex B X, IEEE-754 alias"},
        {"name": "fvertexBy", "address": 148, "description": "Vertex B Y, IEEE-754 alias"},
        {"name": "fvertexCx", "address": 152, "description": "Vertex C X, IEEE-754 alias"},
        {"name": "fvertexCy", "address": 156, "description": "Vertex C Y, IEEE-754 alias"},
        {"name": "fstartR", "address": 160, "description": "Starting red, IEEE-754 alias"},
        {"name": "fstartG", "address": 164, "description": "Starting green, IEEE-754 alias"},
        {"name": "fstartB", "address": 168, "description": "Starting blue, IEEE-754 alias"},
        {"name": "fstartZ", "address": 172, "description": "Starting Z, IEEE-754 alias"},
        {"name": "fstartA", "address": 176, "description": "Starting alpha, IEEE-754 alias"},
        {"name": "fstartS", "address": 180, "description": "Starting S/W, IEEE-754 alias"},
        {"name": "fstartT", "address": 184, "description": "Starting T/W, IEEE-754 alias"},
        {"name": "fstartW", "address": 188, "description": "Starting 1/W, IEEE-754 alias"},
