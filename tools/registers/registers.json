      "name": "TMU",
      "defaults": {"access": "wo", "chips": "TREX", "fifo": true, "sync": true, "reset": null, "side_effect": "state", "fields": []},
      "registers": [
        {"name": "textureMode", "address": 768, "sync": false, "description": "Texture format, filtering and combine", "fields": [{"name": "perspective", "lsb": 0, "msb": 0}, {"name": "min_filter", "lsb": 1, "msb": 1}, {"name": "mag_filter", "lsb": 2, "msb": 2}, {"name": "lod_dither", "lsb": 4, "msb": 4}, {"name": "ncc_select", "lsb": 5, "msb": 5}, {"name": "clamp_s", "lsb": 6, "msb": 6}, {"name": "clamp_t", "lsb": 7, "msb": 7}, {"name": "format", "lsb": 8, "msb": 11}, {"name": "rgb_combine", "lsb": 12, "msb": 20}, {"name": "alpha_combine", "lsb": 21, "msb": 29}, {"name": "trilinear", "lsb": 30, "msb": 30}, {"name": "sequential_download", "lsb": 31, "msb": 31}]},
        {"name": "tLOD", "address": 772, "sync": false, "description": "Texture LOD, aspect and download control", "fields": [{"name": "lod_min", "lsb": 0, "msb": 5}, {"name": "lod_max", "lsb": 6, "msb": 11}, {"name": "lod_bias", "lsb": 12, "msb": 17}, {"name": "odd", "lsb": 18, "msb": 18}, {"name": "split", "lsb": 19, "msb": 19}, {"name": "s_is_wider", "lsb": 20, "msb": 20}, {"name": "aspect", "lsb": 21, "msb": 22}, {"name": "zero_fraction", "lsb": 23, "msb": 23}, {"name": "multibase", "lsb": 24, "msb": 24}, {"name": "data_swizzle", "lsb": 25, "msb": 25}, {"name": "data_swap", "lsb": 26, "msb": 26}, {"name": "direct_write", "lsb": 27, "msb": 27}]},
        {"name": "tDetail", "address": 776, "sync": false, "description": "Texture detail bias and scale"},
        {"name": "texBaseAddr", "address": 780, "sync": false, "description": "Texture base address"},
        {"name": "texBaseAddr1", "address": 784, "sync": false, "description": "Supplemental LOD 1 base"},
        {"name": "texBaseAddr2", "address": 788, "sync": false, "description": "Supplemental LOD 2 base"},
        {"name": "texBaseAddr38", "address": 792, "sync": false, "description": "Supplemental LOD 3-8 base"},
        {"name": "trexInit0", "address": 796, "sync": false, "description": "TREX hardware initialization 0"},
        {"name": "trexInit1", "address": 800, "sync": false, "description": "TREX hardware initialization 1"}
      ]
    }
